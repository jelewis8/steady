# Steady — static PWA on steady.example.com
# Caddy obtains and renews the HTTPS certificate automatically (Let's Encrypt).
# Install to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy

steady.example.com {
	root * /var/www/steady/current
	encode zstd gzip

	# Security headers. The CSP is the technical guarantee behind "no data leaves the device":
	# the page may only talk to its own origin, and nothing here accepts or stores user data.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		Permissions-Policy "microphone=(self), geolocation=(self), camera=(), payment=(), usb=(), bluetooth=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Fingerprinted assets never change — cache forever.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The shell, service worker and manifest must always be revalidated so updates arrive.
	@revalidate path / /index.html /sw.js /manifest.webmanifest /registerSW.js
	header @revalidate Cache-Control "no-cache"

	# No access logs: the server has no reason to keep records of who opened the app.
	log {
		output discard
	}

	# Single-page app fallback
	try_files {path} /index.html
	file_server
}

# Optional: redirect the bare www or other names here
# www.steady.example.com {
# 	redir https://steady.example.com{uri} permanent
# }
